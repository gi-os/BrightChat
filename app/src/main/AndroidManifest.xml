<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- The Calls list in a person's thread (Beeper on only): the phone's own call history,
         read for that person's numbers. Asked for when Calls is first opened. -->
    <uses-permission android:name="android.permission.READ_CALL_LOG" />
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Lifts LightOS's forced grayscale while the full-screen image viewer is
         open (see ColorMode). Signature-level, so it only works after a one-time
         adb grant; ungranted, the app just stays B&W. -->
    <uses-permission
        android:name="android.permission.WRITE_SECURE_SETTINGS"
        tools:ignore="ProtectedPermissions" />
    <!--
      Placing a call from a conversation. The first dangerous permission this app has ever held,
      and it is asked for on the first tap of Call rather than at launch. ACTION_DIAL needs
      nothing and was what v1.3 shipped, but it only ever hands the number to the dialer app to
      display — and LightOS's dialer opens on an empty keypad rather than on the number. CALL
      goes to the telecom stack instead, which parses nothing. Refuse it and the Call verb falls
      back to DIAL rather than going dead; see Dialer.
    -->
    <uses-permission android:name="android.permission.CALL_PHONE" />
    <!-- Reading the SIM's own number, so the call-announce text can name it. Requested
         at the moment the toggle is switched on, never at launch. See CallAnnounce. -->
    <uses-permission android:name="android.permission.READ_PHONE_NUMBERS" />
    <!--
      The address book, for the dialer's contacts list and its T9 search. Asked for the first
      time the Dial tab is opened, not at launch. Read-only and never leaves the phone: the
      BlueBubbles index this app already had is the Mac's contacts and only knows people who have
      iMessaged you, which is no use for ringing a landline.
    -->
    <uses-permission android:name="android.permission.READ_CONTACTS" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.VIBRATE" />
    <!-- The photo picker reads DCIM and Pictures directly, because MediaStore (which
         the system picker uses) is never current on LightOS. See Gallery. VIDEO is a
         separate grant from IMAGES and is what lets a clip be picked and sent; without
         it the grid shows stills only. Both are requested in one prompt. -->
    <uses-permission android:name="android.permission.READ_MEDIA_IMAGES" />
    <uses-permission android:name="android.permission.READ_MEDIA_VIDEO" />
    <uses-permission android:name="android.permission.CAMERA" />
    <!-- Not required: the app is a messaging client first, and a build of LightOS with
         no camera should still install it. CameraScreen says so if there's no camera. -->
    <uses-feature android:name="android.hardware.camera.any" android:required="false" />
    <!-- Not for drawing an overlay. On Android 14 this appop is what exempts us from
         background-activity-start restrictions, which is the only way a sideloaded
         app can put the heads-up box up while the screen is off. Granted over adb;
         LightOS has no Settings UI for it. See HeadsUp. -->
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <!-- remoteMessaging (not dataSync): it's the semantically correct type and,
         crucially, it's one of the FGS types allowed to start from BOOT_COMPLETED
         on Android 14+ (dataSync is blocked at boot). -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_REMOTE_MESSAGING" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <!-- Only to be able to *ask* for the battery-optimisation allowlist (the dialog
         rejects the request without it). The allowlist is what puts the app in the exempt
         standby bucket, which is the difference between the Doze poll running every few
         minutes and being deferred for hours once the phone has been left alone. LightOS
         has no dialog for it, so in practice it's granted over adb — see Delivery. -->
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />

    <!--
      Android 11 package visibility. Without both of these LightNotebook is invisible to
      this app: the contact page's note row would always read "install Notebook" on a phone
      that has it, and `queryIntentActivities` for the note link would come back empty.
      That exact failure cost a day when Roll's send button reported that LightChat could
      not receive photos on a phone with LightChat installed.
    -->
    <queries>
        <package android:name="com.gios.lightnotebook" />
        <!--
          BrightControl, so `getPackageInfo` can answer whether it is still installed. It draws
          the on-screen box for every app now and tells this one to stand down; a remembered
          claim from an app that has since been removed would silence this app's box for good.
          See AlertOwner.
        -->
        <package android:name="com.gios.lightcontrol" />
        <!--
          The dialer, for the Call verb on the contact page and the thread header. Without
          this, `queryIntentActivities` for ACTION_DIAL comes back empty on a phone that
          plainly has a phone app, and the verb hides itself — the same failure mode the
          LightNotebook entry above exists to prevent, and the one that cost a day when Roll
          reported LightChat couldn't receive photos.
        -->
        <intent>
            <action android:name="android.intent.action.DIAL" />
            <data android:scheme="tel" />
        </intent>
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <data android:scheme="lightnotebook" />
        </intent>
    </queries>

    <!--
        Dictating a message. Speech only ever goes to the transcription server the user configured
        themselves, is deleted the moment it comes back as words, and nothing records unless a thumb
        is holding the key down. Without a server set, the key is not there and this is never used.
    -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />

    <application
        android:allowBackup="true"
        android:icon="@drawable/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.LightChat.SplashScreen">
        <!--
          Who you talked to on a day, read-only, by date, for LightNotebook's journal.

          Names only. No message text ever leaves this app and nothing here says what was said — a
          journal wants "talked to Alex", and anything past that is handing over your conversations.
          Answered from the local message table, so it is retroactive across everything synced rather
          than only what happened since some recorder started. See TalkedProvider.
        -->
        <provider
            android:name=".share.TalkedProvider"
            android:authorities="com.gios.lightchat.talked"
            android:exported="true" />

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:screenOrientation="portrait"
            android:launchMode="singleTask"
            android:windowSoftInputMode="stateAlwaysHidden|adjustResize"
            android:configChanges="orientation|screenSize|keyboardHidden">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!--
                Receiving a photograph. Without these filters LightChat cannot be a share
                target at all — an explicit ACTION_SEND aimed at this package resolves to
                nothing, which is why Roll's send button reported that LightChat can't take
                photos on a phone with LightChat installed, and fell back to a chooser.

                SEND and SEND_MULTIPLE are separate actions carrying differently typed extras
                (a Uri versus an ArrayList<Uri>), so registering one does not register the
                other. Roll additionally passes an `address` extra naming the recipient, which
                is the AOSP messaging convention; a sender that omits it still works, the
                photo just waits for a thread to be opened.
            -->
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <action android:name="android.intent.action.SEND_MULTIPLE" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="image/*" />
                <!--
                    And sound. BrightRecorder shares a moment out as `audio/x-wav`, and anything
                    else that shares audio resolves here too. A separate <data> rather than a
                    wildcard: `*/*` would put this app in the chooser for every file on the phone,
                    including the ones it cannot send.
                -->
                <data android:mimeType="audio/*" />
            </intent-filter>
        </activity>

        <!-- The incoming-message box. Floating and sized to its content (see
             HeadsUpActivity), excluded from recents, and never left behind in the
             back stack. singleTop so a burst of messages re-uses one instance. -->
        <activity
            android:name=".HeadsUpActivity"
            android:exported="false"
            android:launchMode="singleTop"
            android:excludeFromRecents="true"
            android:noHistory="true"
            android:taskAffinity=""
            android:showWhenLocked="true"
            android:turnScreenOn="true"
            android:theme="@style/Theme.LightChat.HeadsUp" />

        <!-- Holds the live Socket.IO connection so messages arrive (and notify)
             without Google Play push. remoteMessaging FGS so it can also start at
             boot. -->
        <service
            android:name=".socket.SocketService"
            android:exported="false"
            android:foregroundServiceType="remoteMessaging" />

        <!-- The only thing that runs while the phone is asleep. setAndAllowWhileIdle is
             the one alarm that fires during Doze, and firing it grants a short window of
             network access — which is what makes the catch-up request possible at all.
             See PollAlarm. -->
        <receiver
            android:name=".PollAlarm"
            android:exported="false" />

        <!--
            BrightControl saying whether it is drawing the on-screen box for every app. Exported
            because the sender is another app, and it must be: BrightControl addresses it with
            setPackage, which still needs the receiver to be reachable across the UID boundary.

            Nothing here is trusted with anything. The only thing this can do is stop this app
            drawing its own box; the buzz and the shade notification are never gated on it, so a
            forged broadcast costs a box and cannot silence a message. See AlertOwner.
        -->
        <receiver
            android:name=".AlertOwnerReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="com.gios.lightcontrol.action.ALERTS_OWNED" />
            </intent-filter>
        </receiver>

        <!-- Re-arms everything after the app updates itself. Without this, an Obtainium
             update that lands while the app isn't running leaves no alarm and no socket
             until it's next opened by hand. -->
        <receiver
            android:name=".socket.PackageReplacedReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
            </intent-filter>
        </receiver>

        <!-- Reconnects the socket service after a reboot, no app launch needed. -->
        <receiver
            android:name=".socket.BootReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
            </intent-filter>
        </receiver>

        <!--
            The group conversations, for Roll's send picker. Exported and read-only: Roll asks
            "who is this photograph for?" out of the address book, which knows about people and
            has no way to represent a group iMessage. Groups only, no permission — see
            ChatsProvider for why that trade is the right one here.

            A fixed authority rather than ${applicationId}-derived, because the reader has to
            hardcode it and a suffix that moves with the package id is a string that looks
            configurable and isn't.
        -->
        <provider
            android:name=".share.ChatsProvider"
            android:authorities="com.gios.lightchat.chats"
            android:exported="true" />

        <!-- The one-time login code that just arrived, for three minutes, for LightKeyboard's
             suggestion strip. See CodeProvider. -->
        <provider
            android:name=".share.CodeProvider"
            android:authorities="com.gios.lightchat.code"
            android:exported="true" />

        <!-- Shares downloaded non-image attachments to external apps (ACTION_VIEW /
             share) via a content:// URI — no broad storage permission needed. -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>
        <!--
            LightSync finds apps by provider authority suffix, so this entry is the whole
            registration. exported=true is required for a cross-app ContentProvider and is not
            the trust boundary: LightSyncBackup rejects any caller that is not LightSync by
            package and by signing certificate, checked on every call.
        -->
        <provider
            android:name=".backup.Backup"
            android:authorities="${applicationId}.lightsync.backup"
            android:exported="true" />

    </application>

</manifest>
